@Article{Varlas.etal_2023,
  author   = {Varlas, George and Pytharoulis, Ioannis and Steeneveld, Gert-Jan and Katsafados, Petros and Papadopoulos, Anastasios},
  journal  = {Atmospheric Research},
  title    = {Investigating the impact of sea surface temperature on the development of the {Mediterranean} tropical-like cyclone “{Ianos}” in 2020},
  year     = {2023},
  issn     = {0169-8095},
  month    = aug,
  pages    = {106827},
  volume   = {291},
  abstract = {This study aims to unravel and quantify the impact of sea surface temperature (SST) on the formation, intensity, structure and track of the Mediterranean tropical-like cyclone (medicane) Ianos occurred on 15–20 September 2020 at the central Mediterranean. This study, thus, demonstrates how Ianos would be in past and future climate conditions, assuming that SST changes over the years, but preserving the same atmospheric conditions. To investigate the SST impact, the medicane was simulated using the Advanced Weather and Research Forecasting (WRF-ARW) model. The numerical experiments were initialized either with SST analysis data (control experiment) or applying a uniform decrease and increase to SST analysis by 1 °C and 2 °C (four sensitivity experiments). In this way, the past and future climatic SSTs were concisely approximated. Analysis of various thermodynamic parameters in combination with phase space diagrams, revealing the thermal symmetry and the warm core structure of the cyclone, indicated that Ianos was very sensitive on SST. Thus, SST changes especially by ±2 °C had significant impact on its intensity, changing the period of tropical features while also determining the track and the landfall location. Overall, the average enthalpy flux (i.e., the sum of sensible and latent heat fluxes) in Ianos changed by approximately −39\% and + 50\% when SST changed by −2 °C and + 2 °C, respectively. This, in turn, affected the characteristics of Ianos causing changes for example in the average wind speed (approximately −15\% and + 15\%) and the average precipitation (approximately −56\% and + 44\%). This study quantifies the impacts of SST on Ianos medicane that have important research and socioeconomic implications with a view to a changing future. Therefore, it could support scientists, decision-makers and civil protection in the adaptation to extreme weather phenomena by building climate resilience and sustainability.},
  doi      = {10.1016/j.atmosres.2023.106827},
  file     = {ScienceDirect Full Text PDF:/home/panf/Zotero/storage/Y5DZ2LH3/Varlas et al. - 2023 - Investigating the impact of sea surface temperatur.pdf:application/pdf;ScienceDirect Snapshot:/home/panf/Zotero/storage/WKLD94LR/S0169809523002247.html:text/html},
  keywords = {WRF, Medicane, SST, Air-sea interaction, Extreme weather, Phase-space diagrams},
  language = {en},
  url      = {https://www.sciencedirect.com/science/article/pii/S0169809523002247},
  urldate  = {2023-06-12},
}



