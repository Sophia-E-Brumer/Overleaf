@Article{Sutherland.Gascard_2016a,
  Title                    = {Airborne remote sensing of ocean wave directional wavenumber spectra in the marginal ice zone},
  Author                   = {Sutherland, Peter and Gascard, Jean-Claude},
  Journal                  = {Geophysical Research Letters},
  Year                     = {2016},
  Number                   = {10},
  Pages                    = {5151-5159},
  Volume                   = {43},

  Abstract                 = {Abstract Interactions between surface waves and sea ice are thought to be an important, but poorly understood, physical process in the atmosphere-ice-ocean system. In this work, airborne scanning lidar was used to observe ocean waves propagating into the marginal ice zone (MIZ). These represent the first direct spatial measurements of the surface wavefield in the polar MIZ. Data were compared against two attenuation models, one based on viscous dissipation and one based on scattering. Both models were capable of reproducing the measured wave energy. The observed wavenumber dependence of attenuation was found to be consistent with viscous processes, while the spectral spreading of higher wavenumbers suggested a scattering mechanism. Both models reproduced a change in peak direction due to preferential directional filtering. Floe sizes were recorded using colocated visible imagery, and their distribution was found to be consistent with ice breakup by the wavefield.},
  Doi                      = {10.1002/2016GL067713},
  Eprint                   = {https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1002/2016GL067713},
  Keywords                 = {waves, sea ice, marginal ice zone, ice floe, scanning lidar, attenuation},
  Url                      = {https://agupubs.onlinelibrary.wiley.com/doi/abs/10.1002/2016GL067713}
}

