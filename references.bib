@Article{Deconinck.Segur_1998,
  author      = {Deconinck, B. and Segur, H.},
  journal     = {Phys. D},
  title       = {The {K}{P} equation with quasiperiodic initial data},
  year        = {1998},
  issn        = {0167-2789},
  note        = {Nonlinear waves and solitons in physical systems (Los Alamos, NM, 1997)},
  number      = {1-4},
  pages       = {123--152},
  volume      = {123},
  abstract    = {The Kadomtsev-Petviashvili (KP) equation is known to admit exact,
