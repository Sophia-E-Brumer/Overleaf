@Article{Iga_1999,
  author      = {Iga, K.},
  journal     = {Journal of Fluid Mechanics},
  title       = {A simple criterion for the sign of the pseudomomentum of modes in shallow water systems},
  year        = {1999},
  issn        = {0022-1120},
  pages       = {343--352},
  volume      = {387},
  abstract    = {A simple criterion is derived for determining the sign of the
pseudomomentum of neutral modes in shallow water systems. The sign of
the pseudomomentum is determined by the gradient of the dispersion
curve on a wavenumber vs. phase-speed plane: a mode has pseudomomentum
with the opposite sign to that of the gradient of the dispersion
curve. In most cases, the sign of the pseudomomentum is also
determined only from the value of its phase speed: the pseudomomentum
of a mode is positive if its phase speed is faster than the velocity
of the basic flow at any point and vice versa, but with a few
exceptions. [Author abstract; 8 Refs; In English]},
  coden       = {JFLSA7},
  fjournal    = {Journal of Fluid Mechanics},
  mrclass     = {76E20 (76B15 86A05 86A10)},
