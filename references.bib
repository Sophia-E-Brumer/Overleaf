  author     = {Miglietta, Mario Marcello and Flaounas, Emmanouil and González-Alemán, Juan Jesús and Panegrossi, Giulia and Gaertner, Miguel Angel and Pantillon, Florian and Pasquero, Claudia and Schultz, David M. and D’Adderio, Leo Pio and Dafis, Stavros and Husson, Romain and Ricchi, Antonio and Carrió, Diego Saúl Carrió and Davolio, Silvio and Fita, Lluís and Picornell, Mar\'{i}a \`{A}ngeles and Pytharoulis, Ioannis and Raveh-Rubin, Shira and Scoccimarro, Enrico and Bernini, Lisa and Cavicchia, Leone and Conte, Dario and Ferretti, Rossella and Flocas, Helena and Gutiérrez-Fernández, Jesús and Hatzaki, Maria and Santaner, Victor Homar and Jansà, Agusti and Patlakas, Platon},
