@Article{Gaiser.etal_2004,
  Title                    = {The WindSat spaceborne polarimetric microwave radiometer: sensor description and early orbit performance},
  Author                   = {P. W. Gaiser and
 K. M. St Germain and
 E. M. Twarog and
 G. A. Poe and
 W. Purdy and
 D. Richardson and
 W. Grossman and
 W. L. Jones and
 D. Spencer and
 G. Golba and
