@Article{Kovalyov_1999,
  author      = {Kovalyov, M.},
  journal     = {J. Differential Equations},
  title       = {On the structure of the two-soliton interaction for the {K}orteweg-de {V}ries equation},
  year        = {1999},
  issn        = {0022-0396},
  number      = {2},
  pages       = {431--438},
  volume      = {152},
  abstract    = {In this paper we consider an interaction of two solitons represented by
 a two-soliton solution of KdV. Unlike previous work on the subject
 we do not associate solitons with the maxima of the two-soliton
 solution but with the poles of a certain singular solution which
 can be considered as a two-antisoliton solution since it
 annihilates the original two-soliton solution. Motion of these
 poles may be chosen to represent motion of the solitons
 participating in the interaction and unlike interaction of the two
 maxima, interaction of the poles always proceeds in the same
 manner: The faster one approaches the slower one at a minimal
 distance, where they exchange identities and then separate},
  coden       = {JDEQAK},
  fjournal    = {Journal of Differential Equations},
  mrclass     = {35Q53 (35B40)},
