@Article{Prytherch.etal_2017,
  Title                    = {Direct determination of the air-sea {COextsubscript{2}} gas transfer velocity in Arctic sea ice regions},
  Author                   = {Prytherch, John and Brooks, Ian M. and Crill, Patrick M. and Thornton, Brett F. and Salisbury, Dominic J. and Tjernström, Michael and Anderson, Leif G. and Geibel, Marc C. and Humborg, Christoph},
  Journal                  = {Geophysical Research Letters},
  Year                     = {2017},
  Number                   = {8},
  Pages                    = {3770-3778},
  Volume                   = {44},

  Abstract                 = {Abstract The Arctic Ocean is an important sink for atmospheric {COextsubscript{2}}. The impact of decreasing sea ice extent and expanding marginal ice zones on Arctic air-sea {COextsubscript{2}} exchange depends on the rate of gas transfer in the presence of sea ice. Sea ice acts to limit air-sea gas exchange by reducing contact between air and water but is also hypothesized to enhance gas transfer rates across surrounding open-water surfaces through physical processes such as increased surface-ocean turbulence from ice-water shear and ice-edge form drag. Here we present the first direct determination of the {COextsubscript{2}} air-sea gas transfer velocity in a wide range of Arctic sea ice conditions. We show that the gas transfer velocity increases near linearly with decreasing sea ice concentration. We also show that previous modeling approaches overestimate gas transfer rates in sea ice regions.},
  Doi                      = {10.1002/2017GL073593},
  Eprint                   = {https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1002/2017GL073593},
  Keywords                 = {gas transfer velocity, eddy covariance, sea ice, air-sea {COextsubscript{2}} flux},
  Url                      = {https://agupubs.onlinelibrary.wiley.com/doi/abs/10.1002/2017GL073593}
}

