@Article{Feng.Kawahara_2000,
  author    = {Feng, B. and Kawahara, T.},
  journal   = {Phys. D},
  title     = {Multi-hump stationary waves for a {K}orteweg-de {V}ries equation with nonlocal perturbations},
  year      = {2000},
  number    = {3-4},
  pages     = {237--246},
  volume    = {137},
  abstract  = {Periodic and solitary wave solutions are investigated numerically for
a perturbed Korteweg-de Vries equation with unstable and dissipation
terms in Hilbert transform:
$u_t+uu_x+u_{xxx}+\eta(Hu_x+Hu_{xxx})=0$. A family of solitary wave
solutions $S^{(1)},S^{(2)},...,S^{(n)},...$, whose members are
distinguished by the number of "humps", is numerically identified. The
tails of these waves decay as $O(1/|x|^2)$ when $|x|\rightarrow\infty$
irrespective of the magnitude of $\eta$. It is also found that for a
given $\eta$, there exist families of periodic wave solutions
$P^{(1)},P^{(2)},...,P^{(n)},...$, which originate from one
near-sinusoidal wave and end up in the infinite periodicity to the
corresponding solitary waves. The numerical results are consistent
with the theoretical estimates based on the conservation properties.},
  owner     = {sbrumer},
  timestamp = {2018.03.19},
  url       = {http://www.sciencedirect.com/science?_ob=ArticleURL&_udi=B6TVK-3YBBJ61-3&_coverDate=03%2F15%2F2000&_alid=6613892&_rdoc=1&_fmt=summary&_orig=search&_qd=1&_cdi=5537&_sort=d&_acct=C000024538&_version=1&_urlVersion=0&_userid=499905&md5=99bc3f76a6a82a0a4be47c47916acc6d},
}

@Article{Feng.Kawahara_2000a,
  author    = {Feng, B. and Kawahara, T.},
  journal   = {Phys. D},
  title     = {Stationary travelling-wave solutions of an unstable {K}d{V}-{B}urgers equation},
  year      = {2000},
  number    = {3-4},
  pages     = {228--236},
  volume    = {137},
  abstract  = {Both "solitary" and "periodic" stationary travelling wave solutions
are investigated numerically for an unstable Korteweg-de Vries-Burgers
equation $u_t+uu_x+u_{xxx}-\eta(u+u_{xx})=0 (\eta>0)$. A family of
stationary solitary wave solutions whose members are distinguished by
the number of "humps" is found for a given . Corresponding to each
solitary wave thus found, a family of stationary periodic waves with
the same number of "humps" exists under periodic condition and ends up
in the infinite periodicity to the corresponding solitary wave. The
numerical results are consistent with the theoretical estimates based
on the conservation properties.},
  keywords  = {Unstable Korteweg-de Vries-Burgers equation; Solitary and periodic waves; Multi-hump solutions; Rational Chebyshev and Fourier pseudo-spectral method},
  owner     = {sbrumer},
  timestamp = {2018.03.19},
}

@Article{Feng.Mitsui_1998,
  author    = {Feng, B. and Mitsui, T.},
  journal   = {J. Comput. Appl. Math},
  title     = {A finite difference method for the {K}orteweg-de {V}ries and the {K}adomtsev-{P}etviashvili equations},
  year      = {1998},
  number    = {1},
  pages     = {95--116},
  volume    = {90},
  abstract  = {A linearized implicit finite difference method for the Korteweg-de
Vries equation is proposed and straightforwardly extended to the
Kadomtsev-Petviashvili equation. We investigate the order of accuracy
of the method and prove the method to be unconditionally linearly
stable. The numerical experiments for the Korteweg-de Vries and the
Kadomtsev-Petviashvili equations are carried out with various
conditions. Numerical results for the collision of two lump type
solitary wave solutions to the Kadomtsev-Petviashvili equation are
also reported.},
  owner     = {sbrumer},
  timestamp = {2018.03.19},
}

