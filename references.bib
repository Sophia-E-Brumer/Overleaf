@Article{Dvorak_1975,
  author   = {Dvorak, Vernon F.},
  journal  = {Monthly Weather Review},
  title    = {Tropical {Cyclone} {Intensity} {Analysis} and {Forecasting} from {Satellite} {Imagery}},
  year     = {1975},
  number   = {5},
  pages    = {420--430},
  volume   = {103},
  abstract = {Abstract A technique for using satellite pictures to analyse and forecast tropical cyclone intensifies is described. The cloud features used to estimate the cyclone's intensity and its future change of intensity are described. Procedures for interpreting cloud characteristics and their day-by-day changes within the guidance and constraints of an empirical model of tropical cyclone changes are outlined.},
  doi      = {10.1175/1520-0493(1975)103<0420:TCIAAF>2.0.CO;2},
