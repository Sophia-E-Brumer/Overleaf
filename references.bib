@Article{Deardorff_1980,
  author   = {Deardorff, James W.},
  journal  = {Boundary-Layer Meteorology},
  title    = {Stratocumulus-capped mixed layers derived from a three-dimensional model},
  year     = {1980},
  issn     = {1573-1472},
  number   = {4},
  pages    = {495--527},
  volume   = {18},
  abstract = {Results of a three-dimensional numerical model are analysed in a study of turbulence and entrainment within mixed layers containing stratocumulus with or without parameterized cloud-top radiative cooling. The model eliminates most of the assumptions invoked in theories of cloud-capped mixed layers, but suffers disadvantages which include poor resolution and large truncation errors in and above the capping inversion.},
