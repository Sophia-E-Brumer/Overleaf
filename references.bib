@Article{Orlov.Winternitz_1997,
  author      = {Orlov, A. Y. and Winternitz, P.},
  journal     = {J. Math. Phys.},
  title       = {Algebra of pseudodifferential operators and symmetries of equations in the {K}adomtsev-{P}etviashvili hierarchy},
  year        = {1997},
  issn        = {0022-2488},
  number      = {9},
  pages       = {4644--4674},
  volume      = {38},
  abstract    = {Point symmetries are obtained for all equations in the KP
hierarchy. The Lie algebra for each equation is infinite dimensional
and involves several arbitrary functions of the corresponding time
$t_N$. The symmetry algebra is a semidirect sum of a Virasoro algebra and
a Kac-Moody one. The "positive" part of this algebra is embedded into
the known $W_{\infty}$ algebra of KP symmetries and into the free fermion algebra
$\hat{gl}()$. The corresponding action on the tau-function is presented. The
negative part of the point symmetries does not fit into the free
fermion algebra, but is embedded into a $P_{\infty}$ algebra, based on the
algebra of pseudodifferential operators.},
  coden       = {JMAPAQ},
  fjournal    = {Journal of Mathematical Physics},
  mrclass     = {58F07 (17B68 22E65 58F35)},
  mrnumber    = {98f:58110},
  mrreviewer  = {Piotr G. Grinevich},
  oldentrykey = {#MR98F:58110#},
  owner       = {sbrumer},
  timestamp   = {2018.03.19},
  url         = {http://pubster.aip.org/journal_cgi/getabs?KEY=JMAPAQ&cvips=JMAPAQ000038000009004644000001&gifs=yes},
}

